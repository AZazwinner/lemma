# Copy to .env.local for local dev, or set these as real environment variables on your host (e.g. the Vercel
# project settings). All three are NEXT_PUBLIC_: they are baked into the client bundle at build time, so never
# put a secret in one, and rebuild/redeploy after changing one.

# The backend, as the browser reaches it. http://localhost:12001 in dev; your tunnel hostname when the backend
# is behind a Cloudflare Tunnel (https://api.example.com).
NEXT_PUBLIC_API_URL=http://localhost:12001

# Same backend, WebSocket scheme: ws:// in dev, wss:// whenever the API is https
# (https://api.example.com -> wss://api.example.com). An https page cannot open a ws:// socket.
NEXT_PUBLIC_WS_URL=ws://localhost:12001

# This frontend's own URL. http://localhost:12000 in dev; the real domain when deployed. Used for metadata
# (canonical/OG/sitemap) and for building share links.
# The backend must allow this origin: list it in the backend's CORS_ORIGINS (the dev default, port 12000, is
# always allowed).
NEXT_PUBLIC_APP_URL=http://localhost:12000
