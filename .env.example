# Used by docker-compose.yml. Copy to .env to override. Every line is optional for local development.
# Never commit the real .env (it is gitignored).

# --- Secrets ----------------------------------------------------------------
# POSTGRES_PASSWORD=mathboard-dev
# Signs login tokens. The built-in default is public (it is in this repo), so set your own on any
# instance other people can reach, including one behind a tunnel:  openssl rand -hex 32
# SECRET_KEY=

# --- Where the frontend and backend are --------------------------------------
# The defaults below are for everything running on your own machine.
#
# The browser origin(s) allowed to call the API, comma-separated, scheme + host (+ port), no trailing slash.
# http://localhost:12000 and http://127.0.0.1:12000 are always allowed. Add your frontend's origin if it is
# anywhere else: a Vercel URL, or localhost on another port (e.g. http://localhost:3000).
# CORS_ORIGINS=

# The frontend's own URL. Put in password-reset emails and shared-document links.
# APP_URL=http://localhost:12000
# NEXT_PUBLIC_APP_URL=http://localhost:12000

# The backend, as the BROWSER reaches it. WS URL is the same host with ws:// (or wss:// when the API is https).
# NEXT_PUBLIC_API_URL=http://localhost:12001
# NEXT_PUBLIC_WS_URL=ws://localhost:12001
#
# NEXT_PUBLIC_* are baked into the frontend when it is built. After changing one: docker compose up --build

# --- Backend behind a Cloudflare Tunnel (see README) --------------------------
# Example for a backend at https://api.example.com and a frontend at https://my-app.vercel.app:
#   CORS_ORIGINS=https://my-app.vercel.app
#   APP_URL=https://my-app.vercel.app
#   NEXT_PUBLIC_API_URL=https://api.example.com
#   NEXT_PUBLIC_WS_URL=wss://api.example.com
#   NEXT_PUBLIC_APP_URL=https://my-app.vercel.app
# (On Vercel, set the three NEXT_PUBLIC_* in the project settings instead and redeploy.)
#
# Only accept short-lived tickets on the WebSocket, never the long-lived login token. Tokens in a URL end up in
# proxy logs, and the current frontend always uses tickets.
# WS_ACCEPT_LOGIN_TOKEN=0
#
# Lets the backend see each visitor's real IP from the X-Forwarded-For header. Sign-up and sign-in are rate limited
# per IP, so without this every visitor looks like one machine and five sign-ups lock everyone out for 15 minutes.
# Needed when the backend runs in Docker (its connections arrive from Docker's gateway, not 127.0.0.1). Not needed
# when the backend runs directly on the host next to cloudflared. * is safe with this compose file because it
# publishes ports 12000 and 12001 on 127.0.0.1 only; if you change that, don't use * (anyone who could reach the
# port could forge their IP).
# FORWARDED_ALLOW_IPS=*
#
# Sign-ups allowed per IP per 15 minutes (default 5). Everyone behind one IP shares it, e.g. a room of people on
# the same Wi-Fi. Raise it for a demo. Sign-in and password-reset limits are not affected.
# SIGNUP_MAX_ATTEMPTS=50

# --- Optional -------------------------------------------------------------------
# Password-reset email and the other backend settings are in src/.env.example. Pass them to the backend with an
# `environment:` entry in docker-compose.yml if you want them in Docker.
