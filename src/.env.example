# For running the backend directly (python main.py). Copy to .env and fill in.
# Never commit the real .env (it is gitignored). Docker Compose uses the root .env.example instead.

# JWT signing key. Generate a fresh one for anything other people can reach, and don't reuse it across
# environments:  openssl rand -hex 32
SECRET_KEY=

# Postgres: postgresql://user:password@host:5432/mathboard (postgres:// is accepted too). Percent-encode special
# characters in the password. The schema is created by Alembic, not by the app: run `alembic upgrade head` first.
# sqlite:///./mathboard.db also works for a quick solo run, but it is single-process only.
DATABASE_URL=postgresql://mathboard:change-me@localhost:5432/mathboard

# The port to listen on. Point the Cloudflare Tunnel at http://localhost:<this port>.
# PORT=12001

# The frontend's own URL, used to build password-reset links (APP_URL + "/reset-password?token=...").
# http://localhost:12000 in dev; your frontend's real URL otherwise (e.g. https://my-app.vercel.app).
APP_URL=http://localhost:12000

# Comma-separated browser origins allowed to call the API, on top of http://localhost:12000 and
# http://127.0.0.1:12000 which are always allowed. Set this to wherever the frontend is served from,
# e.g. https://my-app.vercel.app or http://localhost:3000. Scheme + host (+ port), no trailing slash.
CORS_ORIGINS=

# The WebSocket accepts the short-lived tickets the frontend asks for. By default it also still accepts the
# long-lived login token from older frontends. Set to 0 on any instance reachable from the internet
# (a token in a URL ends up in proxy logs).
# WS_ACCEPT_LOGIN_TOKEN=0

# Trust X-Forwarded-For from these peers, so rate limits see each visitor's real IP instead of the proxy's
# (uvicorn setting). The default, 127.0.0.1, is right when cloudflared runs on the same machine as the backend
# and the backend is not in Docker. See the README section on Cloudflare Tunnel.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Postgres connection pool per backend process (defaults shown).
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# Optional. Password-reset emails go out over plain SMTP once SMTP_HOST, SMTP_USER and SMTP_PASSWORD are all set
# (see mailer.py). Until then the reset link is only logged server-side.
#
# Gmail works without owning a domain: turn on 2-Step Verification, create an App Password at
# https://myaccount.google.com/apppasswords, and use it below. Use a dedicated Gmail account for this, not your
# personal one: an app password grants access to the whole account.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-mathboard-account@gmail.com
# SMTP_PASSWORD=
# Optional. Defaults to SMTP_USER. Gmail rewrites the address but keeps the name.
# SMTP_FROM=Mathboard <your-mathboard-account@gmail.com>

# Local dev only. With SMTP unconfigured, also return the reset link in the /forgot-password response.
# NEVER set this on a server anyone else can reach: it lets anyone reset the password of any registered email.
# ALLOW_DEV_RESET_LINK=1

# Optional, for running several backend processes that share live edits. Not needed (or installed) by default:
# `pip install valkey`, then set VALKEY_URL. Without it everything runs in one process on Postgres alone.
# VALKEY_URL=redis://localhost:6379/0

# Tests use a temporary SQLite file by default. To run them against Postgres, with the schema built by Alembic,
# set this; the database name must contain "test" because the suite drops and recreates the public schema.
# TEST_DATABASE_URL=postgresql://mathboard:change-me@localhost:5432/mathboard_test
# With VALKEY installed and this set, the suite also runs its Valkey-backed tests (only keys starting with
# "mb:" are ever deleted).
# TEST_VALKEY_URL=redis://localhost:6379/1
